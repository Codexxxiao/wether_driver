# 复制为 .env 后填写（勿提交 .env）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_SPREADSHEET_TOKEN=
FEISHU_ASSETS_SHEET_ID=
FEISHU_TASKS_SHEET_ID=
FEISHU_ANALYTICS_SHEET_ID=
FEISHU_WEBHOOK_URL=

# 成片模式：full = 口播+BGM+烧录字幕 | clips_only = 仅五段混剪，保留各段素材原声（无需 audio_assets / bgm_assets）
RENDER_MODE=clips_only

# start:all 里 brain-engine 只繁衍指定行（不配置则全款式）
# BRAIN_ONLY_CATEGORY=防晒
# BRAIN_ONLY_STYLE=长款,短款

# feishu-engine 只渲染「待生成」且匹配下值的行（不配置则全部待生成都会处理）
# FEISHU_ONLY_CATEGORY=防晒
# FEISHU_ONLY_STYLE=长款,短款
